GOOGLE_GENERATIVE_AI_API_KEY_1=
GOOGLE_GENERATIVE_AI_API_KEY_2=
GOOGLE_GENERATIVE_AI_API_KEY_3=
GROQ_API_KEY=
# Log API-key slot selection while debugging Google provider fallback.
# DEBUG_API_KEYS=false

E2B_API_KEY=
# Render sandbox template (default eduvids-manim22, see sandbox-templates/eduvids-render).
# E2B_SANDBOX_TEMPLATE=

# English TTS priority: Deepgram Aura-2 -> OpenRouter Flux -> gTTS.
# One provider is locked for the entire render to keep the narrator consistent.
# Non-English narration always uses language-specific gTTS.
OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=deepgram/flux-tts:free
OPENROUTER_TTS_VOICE=flux-sienna-en
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_BASE_URL=https://api.deepgram.com
DEEPGRAM_TTS_MODEL=aura-2-hera-en
DEEPGRAM_TTS_SPEED=1.0
EDUVIDS_TTS_REQUEST_TIMEOUT_SECONDS=60

KV_REST_API_URL=
KV_REST_API_TOKEN=

UPLOADTHING_TOKEN=

# Google OAuth for YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional: public | unlisted | private
YOUTUBE_PRIVACY_STATUS=public
# Optional playlist that receives every successfully uploaded video
YOUTUBE_PLAYLIST_ID=

# Upstash Workflow / QStash
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Override the public Upstash Workflow callback URL when automatic detection is unsuitable.
# UPSTASH_WORKFLOW_URL=
# Allow protected Vercel deployments to receive workflow callbacks.
# VERCEL_AUTOMATION_BYPASS_SECRET=

# Posthog Analytics
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_KEY=

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Set this separately on each Convex deployment to that Clerk instance's
# Frontend API URL (the JWT issuer used by Convex).
CLERK_JWT_ISSUER_DOMAIN=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Prevent convex timeouts
NODE_OPTIONS='--network-family-autoselection-attempt-timeout=1000'
